---
import BandeauCookies from './BandeauCookies.astro';
// Pied de page du site, partagé par Layout.astro et les 4 gabarits d'article
// (refonte UX, lot 8). Une seule source à modifier.
---
<footer>
  <div class="footer-inner">
    <img src="/LOGO_OK.svg" alt="Survivalix" class="footer-logo-img" width="160" height="43" />
    <p class="footer-tagline">Le site de survie pour tout le monde.</p>
    <div class="footer-links">
      <a href="/a-propos">À propos</a>
      <a href="/contact">Contact</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-confidentialite">Confidentialité</a>
      <button type="button" class="lien-cookies" data-gerer-cookies>Gérer mes cookies</button>
      <a href="/ressources">Lexique</a>
    </div>
    <div class="footer-social">
      <a href="https://www.instagram.com/survivalix_off/" target="_blank" rel="noopener noreferrer" aria-label="Survivalix sur Instagram" class="social-icon">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="10" y="10" width="44" height="44" rx="12" stroke="#F5A623" stroke-width="1.5"/>
          <circle cx="32" cy="32" r="12" stroke="#F5A623" stroke-width="1.5"/>
          <circle cx="45" cy="19" r="2.2" fill="#F5A623"/>
        </svg>
      </a>
      <a href="https://www.facebook.com/people/SurvivaliX/61592139130811/" target="_blank" rel="noopener noreferrer" aria-label="Survivalix sur Facebook" class="social-icon">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="22" stroke="#F5A623" stroke-width="1.5"/>
          <path d="M36 24h-4c-2.2 0-4 1.8-4 4v4h-4v6h4v12h6V38h4.5l1-6H34v-3c0-1 .5-2 2-2h3v-6.5c0 0-1.8-.5-3-.5z" stroke="#F5A623" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
    <p class="footer-copy">© {new Date().getFullYear()} Survivalix — Tous droits réservés</p>
  </div>
</footer>

<BandeauCookies />

<style>
  /* RÉSEAUX SOCIAUX — FOOTER */
  .footer-social {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    margin: 1.2rem 0;
  }

  .social-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    opacity: 0.75;
    transition: opacity 0.2s, transform 0.2s;
  }

  .social-icon:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .social-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
