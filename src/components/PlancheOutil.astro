---
// Visuel « planche technique » des cartes d'outils (refonte UX, lot 7, piste choisie par Boris).
// Dessin vectoriel au trait ambre sur fond noir, façon plan coté. Décoratif : aria-hidden.
// Chaque planche a ses propres identifiants de motifs (suffixe = outil) pour coexister sur une page.
interface Props {
  outil: 'eau' | 'rations' | 'evaluateur' | 'kit';
}
const { outil } = Astro.props;
const id = (nom: string) => `${nom}-${outil}`;
const A = '#F5A623';
const C = '#F5E6C8';

const cartouches = {
  eau: ['FICHE EAU', '6 L', '72 H'],
  rations: ['FICHE VIVRES', 'KCAL', '72 H'],
  evaluateur: ['FICHE BILAN', '10 Q.', '/100'],
  kit: ['FICHE KIT', 'FOYER', '72 H'],
}[outil];
---
<svg viewBox="0 0 400 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id={id('g')} width="10" height="10" patternUnits="userSpaceOnUse"><path d="M10 0H0V10" fill="none" stroke={A} stroke-width=".3" opacity=".22" /></pattern>
    <pattern id={id('G')} width="50" height="50" patternUnits="userSpaceOnUse"><path d="M50 0H0V50" fill="none" stroke={A} stroke-width=".6" opacity=".22" /></pattern>
    <marker id={id('f')} viewBox="0 0 6 6" refX="3" refY="3" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L6 3L0 6Z" fill={A} /></marker>
  </defs>

  <rect width="400" height="170" fill="#0d0d0d" />
  <rect width="400" height="170" fill={`url(#${id('g')})`} />
  <rect width="400" height="170" fill={`url(#${id('G')})`} />

  <g fill="none" stroke={A} stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
    {outil === 'eau' && (
      <>
        <!-- bouteille de face, niveau d'eau et graduations -->
        <path d="M170 150 V70 q0 -14 12 -22 v-16 h-4 v-10 h24 v10 h-4 v16 q12 8 12 22 V150 Z" />
        <path d="M170 92 h44 M170 128 h44" stroke-dasharray="3 3" />
        <path d="M172 102 q10 -4 20 0 t20 0" stroke={C} />
        <g stroke-width="1">{[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <line x1="214" x2={i % 2 ? 220 : 226} y1={146 - i * 8} y2={146 - i * 8} />)}</g>
        <!-- cote de hauteur -->
        <line x1="150" y1="150" x2="150" y2="22" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
        <path d="M146 150 H168 M146 22 H176" stroke-width=".8" />
        <!-- vue de dessus -->
        <circle cx="290" cy="80" r="34" />
        <circle cx="290" cy="80" r="12" />
        <path d="M246 80 H334 M290 36 V124" stroke-dasharray="6 3 1 3" stroke-width=".8" />
        <line x1="256" y1="132" x2="324" y2="132" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
      </>
    )}

    {outil === 'rations' && (
      <>
        <!-- boîte de conserve en élévation -->
        <ellipse cx="190" cy="52" rx="34" ry="9" />
        <path d="M156 52 V138 M224 52 V138" />
        <path d="M156 138 a34 9 0 0 0 68 0" />
        <path d="M156 66 a34 9 0 0 0 68 0 M156 124 a34 9 0 0 0 68 0" stroke-dasharray="3 3" stroke-width="1" />
        <rect x="164" y="80" width="52" height="30" stroke={C} stroke-width="1.2" />
        <path d="M172 95 h36" stroke={C} stroke-width="1" />
        <!-- clé d'ouverture -->
        <path d="M190 43 q10 -10 22 -4" stroke-width="1.2" />
        <!-- cotes -->
        <line x1="138" y1="52" x2="138" y2="138" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
        <path d="M134 52 H152 M134 138 H152" stroke-width=".8" />
        <line x1="156" y1="156" x2="224" y2="156" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
        <!-- bocal -->
        <path d="M262 62 h44 v10 h-4 v66 q0 8 -8 8 h-20 q-8 0 -8 -8 v-66 h-4 Z" />
        <path d="M266 72 h36" stroke-width="1" />
        <g stroke={C} stroke-width="1"><circle cx="276" cy="110" r="3" /><circle cx="286" cy="118" r="3" /><circle cx="294" cy="106" r="3" /><circle cx="280" cy="126" r="3" /><circle cx="292" cy="130" r="3" /><circle cx="284" cy="98" r="3" /></g>
        <path d="M262 90 h44" stroke-dasharray="3 3" stroke-width="1" />
        <!-- axe -->
        <path d="M190 30 V150" stroke-dasharray="6 3 1 3" stroke-width=".8" />
      </>
    )}

    {outil === 'evaluateur' && (
      <>
        <!-- planchette et liste à cocher -->
        <rect x="150" y="26" width="92" height="128" rx="4" />
        <rect x="176" y="18" width="40" height="16" rx="3" />
        <circle cx="196" cy="26" r="3" stroke-width="1.2" />
        {[0, 1, 2, 3].map((i) => (
          <>
            <rect x="162" y={50 + i * 24} width="12" height="12" stroke-width="1.2" />
            <path d={`M182 ${56 + i * 24} H${i % 2 ? 222 : 230}`} stroke-width="1" />
          </>
        ))}
        <path d="M164 56 l4 4 l8 -10 M164 80 l4 4 l8 -10" stroke={C} stroke-width="2" />
        <!-- compteur de score -->
        <path d="M262 120 a40 40 0 0 1 80 0" />
        <path d="M270 120 a32 32 0 0 1 64 0" stroke-dasharray="2 4" stroke-width="1" />
        <g stroke-width="1">{[0, 1, 2, 3, 4].map((i) => {
          const a = Math.PI - (i * Math.PI) / 4;
          return <line x1={302 + Math.cos(a) * 40} y1={120 - Math.sin(a) * 40} x2={302 + Math.cos(a) * 46} y2={120 - Math.sin(a) * 46} />;
        })}</g>
        <line x1="302" y1="120" x2="326" y2="96" stroke={C} stroke-width="2" />
        <circle cx="302" cy="120" r="4" />
        <line x1="262" y1="138" x2="342" y2="138" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
      </>
    )}

    {outil === 'kit' && (
      <>
        <!-- sac adulte -->
        <path d="M150 150 V68 q0 -26 34 -26 h12 q34 0 34 26 V150 Z" />
        <path d="M176 42 q14 -16 28 0" />
        <rect x="164" y="96" width="52" height="40" rx="4" />
        <path d="M164 108 h52" stroke-width="1" />
        <path d="M150 80 h80" stroke-dasharray="3 3" stroke-width="1" />
        <!-- sac enfant -->
        <path d="M252 150 V100 q0 -16 20 -16 h8 q20 0 20 16 V150 Z" />
        <path d="M268 84 q8 -10 16 0" />
        <rect x="262" y="118" width="28" height="22" rx="3" stroke-width="1.2" />
        <!-- lampe frontale en éclaté -->
        <circle cx="330" cy="62" r="8" />
        <path d="M322 62 q-14 0 -14 -12 M338 62 q14 0 14 -12" stroke-width="1" />
        <path d="M330 54 V40 M342 56 l8 -8 M318 56 l-8 -8" stroke={C} stroke-width="1.2" />
        <path d="M300 96 L322 70" stroke-dasharray="2 3" stroke-width=".8" />
        <!-- cotes -->
        <line x1="132" y1="150" x2="132" y2="42" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
        <path d="M128 150 H148 M128 42 H178" stroke-width=".8" />
        <line x1="252" y1="160" x2="300" y2="160" marker-start={`url(#${id('f')})`} marker-end={`url(#${id('f')})`} stroke-width="1" />
      </>
    )}

    <!-- cartouche -->
    <rect x="20" y="118" width="96" height="36" />
    <path d="M20 132 H116 M68 132 V154" stroke-width=".8" />
  </g>

  <g fill={A} font-family="Oswald, sans-serif" font-size="9" letter-spacing="1">
    <text x="24" y="128">{cartouches[0]}</text>
    <text x="24" y="147">{cartouches[1]}</text>
    <text x="72" y="147">{cartouches[2]}</text>
  </g>
  <rect x="4" y="4" width="392" height="162" fill="none" stroke={A} stroke-width="1" opacity=".6" />
</svg>
