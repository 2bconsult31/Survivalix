---
import { imageDispo } from '../utils/image';
import { existsSync } from 'node:fs';
// Balises SEO communes à TOUS les articles (manuel, radar, cantine, atelier).
// L'adresse du site vient de astro.config.mjs (site: 'https://www.survivalix.fr') :
// une seule source, plus jamais d'URL codée en dur dans un layout.
const { frontmatter } = Astro.props;

const SITE_URL = Astro.site ?? new URL('https://www.survivalix.fr');
const pageTitle = frontmatter.seo_title || frontmatter.title;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString();
// Auteur des articles (même nom que dans les mentions légales), relié à la page À propos.
const auteur = { "@type": "Person", "name": "Boris Bendjemla", "url": new URL('/a-propos', SITE_URL).toString() };
const ogImageURL = new URL(imageDispo(frontmatter.image) || '/og-image.jpg', SITE_URL).toString();
const logoURL = new URL('/LOGO_OK.svg', SITE_URL).toString();
// Questions fréquentes : extraites de la section « Questions fréquentes » de l'article
// (voir src/utils/faq.ts), passées par [slug].astro dans frontmatter.faq.
const faq: { question: string; answer: string }[] = frontmatter.faq ?? [];

// Fil d'Ariane (JSON-LD BreadcrumbList) : Accueil > Rubrique > Article, pour tous les articles.
const RUBRIQUES: Record<string, string> = {
  manuel: 'Le Manuel',
  radar: 'Le Radar',
  cantine: 'La Cantine',
  atelier: "L'Atelier",
};
const rubrique = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const breadcrumb = RUBRIQUES[rubrique]
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": new URL('/', SITE_URL).toString() },
        { "@type": "ListItem", "position": 2, "name": RUBRIQUES[rubrique], "item": new URL(`/${rubrique}`, SITE_URL).toString() },
        { "@type": "ListItem", "position": 3, "name": frontmatter.title, "item": canonicalURL },
      ],
    }
  : null;

// Recette (JSON-LD Recipe), uniquement pour la Cantine et si les champs de recette sont renseignés.
// Aucune note ni aucun avis (aggregateRating, review) : nous n'en avons pas de vrais.
// Pas de champ nutrition : aucune valeur calorique sourcée par la table Ciqual (ANSES) dans les recettes.
const estRecette = rubrique === 'cantine' && Array.isArray(frontmatter.recipeIngredient) && frontmatter.recipeIngredient.length > 0;
let recipe = null;
if (estRecette) {
  // Images : recadrages 16:9, 4:3 et 1:1 générés au build (src/integrations/images-optimisees.mjs),
  // l'image d'origine en secours s'ils n'existent pas.
  const nomImage = (frontmatter.image ?? '').split('/').pop()?.replace(/\.(jpe?g|png)$/i, '');
  const recadrages = ['16x9', '4x3', '1x1']
    .map((r) => `/images/_opt/cantine/${nomImage}-${r}.jpg`)
    .filter((chemin) => existsSync(`public${chemin}`))
    .map((chemin) => new URL(chemin, SITE_URL).toString());
  const facultatif = (cle: string, valeur: unknown) => (valeur ? { [cle]: valeur } : {});
  recipe = {
    "@context": "https://schema.org",
    "@type": "Recipe",
    "name": frontmatter.title,
    "image": recadrages.length > 0 ? recadrages : [ogImageURL],
    "description": frontmatter.description,
    "datePublished": frontmatter.date,
    "dateModified": frontmatter.updated ?? frontmatter.date,
    "author": auteur,
    ...facultatif('prepTime', frontmatter.prepTime),
    ...facultatif('cookTime', frontmatter.cookTime),
    ...facultatif('totalTime', frontmatter.totalTime),
    ...facultatif('recipeYield', frontmatter.recipeYield),
    ...facultatif('recipeCategory', frontmatter.recipeCategory),
    ...facultatif('recipeCuisine', frontmatter.recipeCuisine),
    ...facultatif('keywords', frontmatter.keywords?.join(', ')),
    "recipeIngredient": frontmatter.recipeIngredient,
    ...facultatif('recipeInstructions', frontmatter.recipeInstructions?.map((texte: string, i: number) => ({
      "@type": "HowToStep",
      "position": i + 1,
      "text": texte,
    }))),
  };
}
---

<meta name="description" content={frontmatter.description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={frontmatter.description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Survivalix" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={frontmatter.description} />
<meta name="twitter:image" content={ogImageURL} />

<meta name="robots" content="index, follow" />

<!-- JSON-LD Article -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "image": ogImageURL,
  "datePublished": frontmatter.date,
  "dateModified": frontmatter.updated ?? frontmatter.date,
  "author": auteur,
  "publisher": {
    "@type": "Organization",
    "name": "Survivalix",
    "logo": { "@type": "ImageObject", "url": logoURL }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL }
})} />

<!-- JSON-LD BreadcrumbList : Accueil > Rubrique > Article -->
{breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}

<!-- JSON-LD Recipe, seulement pour les recettes de la Cantine -->
{recipe && <script type="application/ld+json" set:html={JSON.stringify(recipe)} />}

<!-- JSON-LD FAQPage, seulement si l'article a une section « Questions fréquentes » (en complément de l'Article, sans le dupliquer) -->
{faq.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": { "@type": "Answer", "text": item.answer }
    }))
  })} />
)}

<!-- Google Consent Mode v2 : tout est refusé par défaut, AVANT tout script Google.
     Le bandeau CMP de Google (AdSense) met ensuite à jour le consentement. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500
  });
</script>

<!-- Google AdSense -->
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3877882826995901" crossorigin="anonymous"></script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PPFYTX79ND"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-PPFYTX79ND');
</script>
