---
import ConsentementDefaut from '../components/ConsentementDefaut.astro';
import Ticker from '../components/Ticker.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

const { 
  title, 
  description = "Survivalix — Le site de survie pour tout le monde. Guides pratiques, recettes, outils interactifs et humour post-apo.",
  image = "/og-image.jpg",
  robots = "index, follow"
} = Astro.props;

const url = Astro.url;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ConsentementDefaut />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3877882826995901" crossorigin="anonymous"></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Oswald:wght@300;400;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Oswald:wght@300;400;700&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Survivalix" />
    <meta name="robots" content={robots} />

    <!-- Google tag (gtag.js) — chargé après le rendu initial pour ne pas bloquer le LCP -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PPFYTX79ND');

      function loadGA() {
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-PPFYTX79ND';
        document.head.appendChild(script);
        window.removeEventListener('load', loadGA);
      }
      window.addEventListener('load', loadGA);
    </script>
  </head>
  <body>

    <div class="scanlines"></div>

    <SiteHeader />

    <Ticker />

    <main>
      <slot />
    </main>

    <SiteFooter />

  </body>
</html>


<style>
  /* MAIN */
  main {
    max-width: 1300px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  @media (min-width: 768px) {
    main { padding: 3rem 2rem; }
  }

  /* CARTES RUBRIQUES — uniquement dans main */
  main ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 600px) {
    main ul { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 900px) {
    main ul { grid-template-columns: repeat(3, 1fr); }
  }

  main ul li {
    background-color: #0d0d0d;
    border: 1px solid var(--filet);
    border-top: 3px solid #F5A623;
    padding: 1.2rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  main ul li:hover {
    background-color: #141414;
    transform: translateY(-2px);
  }

  main ul li a {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #F5E6C8;
    text-decoration: none;
    letter-spacing: 1px;
  }

  main ul li a:hover { color: #F5A623; }

  main ul li p {
    font-size: 0.85rem;
    margin-top: 0.5rem;
    opacity: 0.7;
    margin-bottom: 0;
  }

</style>