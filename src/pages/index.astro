---
import ImageOpt from '../components/ImageOpt.astro';
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// ---------- Articles : toutes rubriques confondues ----------
const RUBRIQUES = [
  { collection: 'manuel', nom: 'Le Manuel' },
  { collection: 'radar', nom: 'Le Radar' },
  { collection: 'cantine', nom: 'La Cantine' },
  { collection: 'atelier', nom: "L'Atelier" },
] as const;

const tous = (
  await Promise.all(
    RUBRIQUES.map(async ({ collection, nom }) =>
      (await getCollection(collection)).map((a) => ({
        url: `/${collection}/${a.id}`,
        rubrique: nom,
        collection,
        titre: a.data.title,
        description: a.data.description,
        image: a.data.image,
        date: a.data.date,
        updated: a.data.updated,
      })),
    ),
  )
).flat();

// « Les plus récents » = date de publication, du plus récent au plus ancien.
tous.sort((a, b) => b.date.getTime() - a.date.getTime());

// Le dernier article Radar est mis en avant à part ; il n'est pas répété dans la grille.
const alaUne = tous.find((a) => a.collection === 'radar');
const dernieres = tous.filter((a) => a !== alaUne).slice(0, 6);

const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
// Date affichée : la mise à jour si elle est postérieure à la publication, sinon la publication.
const dateAffichee = (a: { date: Date; updated?: Date }) =>
  a.updated && a.updated.getTime() > a.date.getTime()
    ? { libelle: 'Mis à jour le', date: a.updated }
    : { libelle: 'Publié le', date: a.date };

// ---------- Rubriques ----------
// Illustration de rubrique : public/images/rubriques/<slug>.jpg (1200 × 900 environ, format 4:3).
// Tant que le fichier n'existe pas, la carte garde son pictogramme.
const RUBRIQUES_DATA = [
  {
    "slug": "manuel",
    "onglet": "01",
    "titre": "Le Manuel",
    "desc": "Guides de fond, checklists, méthodes éprouvées.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <rect x=\"14\" y=\"6\" width=\"36\" height=\"52\" rx=\"2\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <rect x=\"14\" y=\"6\" width=\"8\" height=\"52\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <line x1=\"28\" y1=\"18\" x2=\"44\" y2=\"18\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"28\" y1=\"26\" x2=\"44\" y2=\"26\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"28\" y1=\"34\" x2=\"44\" y2=\"34\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"28\" y1=\"42\" x2=\"38\" y2=\"42\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <circle cx=\"18\" cy=\"20\" r=\"1.5\" fill=\"#F5A623\"/> <circle cx=\"18\" cy=\"32\" r=\"1.5\" fill=\"#F5A623\"/> <circle cx=\"18\" cy=\"44\" r=\"1.5\" fill=\"#F5A623\"/> </svg>"
  },
  {
    "slug": "cantine",
    "onglet": "02",
    "titre": "La Cantine",
    "desc": "Recettes de survie qui ont vraiment du goût.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M12 28 C12 16 20 10 32 10 C44 10 52 16 52 28 L50 48 C50 51 47 54 44 54 L20 54 C17 54 14 51 14 48 Z\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <ellipse cx=\"32\" cy=\"28\" rx=\"20\" ry=\"6\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"22\" y1=\"6\" x2=\"22\" y2=\"12\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"32\" y1=\"4\" x2=\"32\" y2=\"10\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"42\" y1=\"6\" x2=\"42\" y2=\"12\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <path d=\"M20 38 Q32 34 44 38\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/> </svg>"
  },
  {
    "slug": "bunker",
    "onglet": "IA",
    "titre": "Le Bunker",
    "desc": "Assistant IA — pose tes questions, reçois des réponses personnalisées.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <rect x=\"12\" y=\"20\" width=\"40\" height=\"32\" rx=\"2\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <rect x=\"20\" y=\"28\" width=\"8\" height=\"6\" rx=\"1\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <rect x=\"36\" y=\"28\" width=\"8\" height=\"6\" rx=\"1\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"24\" y1=\"42\" x2=\"40\" y2=\"42\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"32\" y1=\"12\" x2=\"32\" y2=\"20\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <circle cx=\"32\" cy=\"10\" r=\"3\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"16\" y1=\"36\" x2=\"8\" y2=\"36\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"48\" y1=\"36\" x2=\"56\" y2=\"36\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> </svg>"
  },
  {
    "slug": "atelier",
    "onglet": "03",
    "titre": "L'Atelier",
    "desc": "DIY, autonomie, faire soi-même avec ce qu'on a.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M42 8 C48 8 54 14 52 20 C51 24 48 26 48 26 L18 56 L10 48 L40 18 C40 18 40 14 42 8 Z\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/> <circle cx=\"14\" cy=\"52\" r=\"4\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"46\" y1=\"12\" x2=\"52\" y2=\"18\" stroke=\"#F5A623\" stroke-width=\"2\" stroke-linecap=\"round\"/> </svg>"
  },
  {
    "slug": "outils",
    "onglet": "04",
    "titre": "Les Outils",
    "desc": "Calculateurs, checklists interactives, générateurs.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <rect x=\"6\" y=\"6\" width=\"16\" height=\"16\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <rect x=\"26\" y=\"6\" width=\"16\" height=\"16\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <rect x=\"6\" y=\"26\" width=\"16\" height=\"16\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <rect x=\"26\" y=\"26\" width=\"16\" height=\"16\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <line x1=\"10\" y1=\"14\" x2=\"18\" y2=\"14\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"30\" y1=\"11\" x2=\"38\" y2=\"11\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"30\" y1=\"16\" x2=\"34\" y2=\"16\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"10\" y1=\"34\" x2=\"18\" y2=\"34\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <circle cx=\"46\" cy=\"46\" r=\"10\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <line x1=\"53\" y1=\"53\" x2=\"58\" y2=\"58\" stroke=\"#F5A623\" stroke-width=\"2\" stroke-linecap=\"round\"/> </svg>"
  },
  {
    "slug": "radar",
    "onglet": "05",
    "titre": "Le Radar",
    "desc": "Veille, signaux faibles, actu qui compte.",
    "svg": "<svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"> <circle cx=\"32\" cy=\"32\" r=\"22\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\"/> <circle cx=\"32\" cy=\"32\" r=\"14\" stroke=\"#F5A623\" stroke-width=\"1.5\" fill=\"none\" stroke-dasharray=\"3 3\"/> <circle cx=\"32\" cy=\"32\" r=\"6\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <circle cx=\"32\" cy=\"32\" r=\"2\" fill=\"#F5A623\"/> <line x1=\"32\" y1=\"10\" x2=\"32\" y2=\"32\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> <line x1=\"32\" y1=\"32\" x2=\"48\" y2=\"22\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\"0.5\"/> <circle cx=\"48\" cy=\"20\" r=\"3\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"32\" y1=\"54\" x2=\"32\" y2=\"60\" stroke=\"#F5A623\" stroke-width=\"1.5\"/> <line x1=\"22\" y1=\"60\" x2=\"42\" y2=\"60\" stroke=\"#F5A623\" stroke-width=\"1.5\" stroke-linecap=\"round\"/> </svg>"
  }
];

const rubriques = RUBRIQUES_DATA.map((r) => {
  const fichier = `/images/rubriques/${r.slug}.jpg`;
  return { ...r, illustration: existsSync(`public${fichier}`) ? fichier : null };
});
---

<Layout
  title="Survivalix : le site de survie pour tout le monde"
  description="Guides, recettes, calculateurs et IA de survie pour urbains curieux. Kit 72h, autonomie, prepping sans clichés ni bullshit. Sourcé et décalé."
>

  <!-- OUVERTURE -->
  <section class="hero">
    <ImageOpt
      class="hero-img"
      src="/images/articles/sac-evacuation.jpg"
      alt=""
      width="1584"
      height="672"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-texte">
      <h1 class="hero-titre">La survie,<br/>c'est pour tout le monde.</h1>
      <p class="hero-accroche">
        Guides pratiques, recettes qui ont du goût, outils interactifs
        et humour second degré. Tout ce qu'il faut savoir pour être prêt
        sans devenir parano.
      </p>
      <div class="hero-ctas">
        <a href="/commencer-ici" class="btn-primary">Par où commencer ?</a>
        <a href="/survivant" class="btn-secondary">Quel Survivant es-tu ?</a>
      </div>
    </div>
  </section>

  <!-- RADAR À LA UNE -->
  {alaUne && (() => { const d = dateAffichee(alaUne); return (
    <section class="une" aria-labelledby="une-titre">
      <a href={alaUne.url} class="une-carte fiche" data-onglet="LE RADAR">
        {alaUne.image && (
          <ImageOpt class="une-img" src={alaUne.image} alt="" width="1584" height="672" sizes="(min-width: 1300px) 680px, (min-width: 900px) 55vw, 100vw" />
        )}
        <div class="une-corps">
          <p class="une-kicker">À la une du Radar</p>
          <h2 id="une-titre" class="une-titre">{alaUne.titre}</h2>
          <p class="une-desc">{alaUne.description}</p>
          <p class="une-meta">
            <span>{d.libelle} <time datetime={iso(d.date)}>{fmt.format(d.date)}</time></span>
            <span class="une-lire" aria-hidden="true">Lire →</span>
          </p>
        </div>
      </a>
    </section>
  ); })()}

  <!-- DERNIÈRES FICHES -->
  <section class="dernieres" aria-labelledby="dernieres-titre">
    <h2 id="dernieres-titre">Dernières fiches</h2>
    <ul class="dernieres-grid" role="list">
      {dernieres.map((a) => { const d = dateAffichee(a); return (
        <li>
          <a href={a.url} class="fiche-article fiche" data-onglet={a.rubrique.toUpperCase()}>
            {a.image && (
              <ImageOpt src={a.image} alt="" width="1584" height="672" sizes="(min-width: 1300px) 400px, (min-width: 1000px) 31vw, (min-width: 600px) 48vw, 100vw" />
            )}
            <div class="fiche-article-corps">
              <h3>{a.titre}</h3>
              <p class="fiche-article-meta">
                <span class="sr-only">{a.rubrique}, </span>{d.libelle} <time datetime={iso(d.date)}>{fmt.format(d.date)}</time>
              </p>
            </div>
          </a>
        </li>
      ); })}
    </ul>
  </section>

  <!-- C'EST QUOI CE SITE -->
  <section class="reassurance" aria-labelledby="reassurance-titre">
    <h2 id="reassurance-titre">C'est quoi ce site ?</h2>
    <p class="reassurance-texte">
      Survivalix c'est pour toi si tu as déjà pensé <em>"et si ça merde vraiment ?"</em>
      sans savoir quoi faire. Pas de théories complotistes, pas d'arsenal militaire,
      pas de sermon. Juste des infos utiles, présentées sans se prendre au sérieux.
    </p>
    <ul class="reassurance-points">
      <li>Tu habites en ville ? On a tout prévu pour toi.</li>
      <li>Pas besoin d'un gros budget pour commencer.</li>
      <li>Le sujet te fascine, mais tu ne te dirais jamais survivaliste ? Tu es au bon endroit.</li>
      <li>Tu veux bien manger même en cas de crise ? On a les recettes.</li>
    </ul>
  </section>

  <!-- PAR OÙ COMMENCER -->
  <section class="demarrer" aria-labelledby="demarrer-titre">
    <h2 id="demarrer-titre">Tu débarques ici ?</h2>
    <p class="demarrer-intro">Trois premiers pas, dans l'ordre que tu veux.</p>
    <ol class="missions">
      <li class="mission">
        <h3>Découvre ton profil</h3>
        <p>Fais le quiz et reçois ta carte Survivant personnalisée à partager.</p>
        <a href="/survivant" class="mission-lien">Faire le quiz →</a>
      </li>
      <li class="mission">
        <h3>Monte ton kit 72h</h3>
        <p>Le strict minimum pour tenir 3 jours sans rien. Simple, sans bullshit.</p>
        <a href="/manuel/kit-urgence-72h" class="mission-lien">Voir le guide →</a>
      </li>
      <li class="mission">
        <h3>Pose tes questions</h3>
        <p>L'assistant IA du Bunker répond à tout, sans jargon, avec humour.</p>
        <a href="/bunker" class="mission-lien">Accéder au Bunker →</a>
      </li>
    </ol>
  </section>

  <!-- RUBRIQUES -->
  <section class="rubriques" aria-labelledby="rubriques-titre">
    <h2 id="rubriques-titre">Explore le site</h2>
    <div class="rubriques-grid">
      {rubriques.map((r) => (
        <a href={`/${r.slug}`} class:list={['rubrique-card', 'fiche', { 'avec-illustration': r.illustration }]} data-onglet={r.onglet}>
          {r.illustration ? (
            <ImageOpt class="rubrique-illu" src={r.illustration} alt="" width="1200" height="900" sizes="(min-width: 1300px) 400px, (min-width: 768px) 31vw, 48vw" />
          ) : (
            <div class="rubrique-icon" set:html={r.svg} />
          )}
          <div class="rubrique-corps">
            <h3>{r.titre}</h3>
            <p>{r.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- QUIZ -->
  <section class="quiz-cta">
    <div class="quiz-cta-inner">
      <h2>Quel type de Survivant es-tu ?</h2>
      <p>
        Le Bâtisseur ? Le Nourricier ? L'Explorateur ? Le Technicien ?
        Fais le quiz en 2 minutes et télécharge ta carte collector personnalisée.
      </p>
      <a href="/survivant" class="btn-primary">Découvrir mon profil</a>
    </div>
  </section>

</Layout>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  section { padding: 4rem 0; border-bottom: 1px solid #222; }
  section:last-of-type { border-bottom: none; }

  h2 {
    font-family: 'Special Elite', cursive;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: #F5A623;
    margin-bottom: 1.5rem;
  }

  /* ---------- OUVERTURE ---------- */
  .hero {
    position: relative;
    /* bord à bord : sort de la colonne centrale de <main> */
    margin: -2rem calc(50% - 50vw) 0;
    padding: 0;
    border-bottom: 3px solid #F5A623;
    background-color: #0d0d0d;
  }

  :global(.hero-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1584 / 672;
    object-fit: cover;
  }

  .hero-texte {
    position: relative;
    padding: 2rem 1rem 2.5rem;
    text-align: center;
  }

  .hero-titre {
    font-family: 'Special Elite', cursive;
    font-size: clamp(1.8rem, 6vw, 3.4rem);
    color: #F5A623;
    line-height: 1.1;
    margin-bottom: 1.2rem;
    letter-spacing: 2px;
  }

  .hero-accroche {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: #ffffff;
    max-width: 640px;
    margin: 0 auto 2rem;
    opacity: 0.9;
    line-height: 1.7;
    font-weight: 300;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .hero { margin-top: -3rem; }
    :global(.hero-img) { max-height: 78vh; }
    /* Sur grand écran, le texte se pose en bas de l'illustration, sur un fondu noir */
    .hero-texte {
      position: absolute;
      inset: auto 0 0 0;
      padding: 8rem 2rem 3rem;
      background: linear-gradient(to bottom, rgba(13,13,13,0) 0%, rgba(13,13,13,0.82) 45%, #0d0d0d 100%);
    }
    .hero-accroche { opacity: 0.95; }
  }

  .btn-primary,
  .btn-secondary {
    font-family: 'Oswald', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border: 2px solid #F5A623;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    display: inline-block;
  }
  .btn-primary { background-color: #F5A623; color: #0d0d0d; }
  .btn-primary:hover { background-color: #c4811a; border-color: #c4811a; color: #0d0d0d; }
  .btn-secondary { background-color: #0d0d0d; color: #F5A623; }
  .btn-secondary:hover { background-color: #F5A623; color: #0d0d0d; }

  /* ---------- RADAR À LA UNE ---------- */
  .une { padding-top: 4.5rem; }

  .une-carte {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    text-decoration: none;
    background-color: #0d0d0d;
    transition: background-color 0.2s;
  }
  .une-carte:hover { background-color: #141414; }
  .une-carte:hover .une-titre { text-decoration: underline; text-underline-offset: 4px; }

  :global(.une-img) { width: 100%; height: 100%; aspect-ratio: 1584 / 672; object-fit: cover; display: block; }

  .une-corps { padding: 1.5rem 1.2rem 1.8rem; }

  @media (min-width: 900px) {
    .une-carte { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; }
    :global(.une-img) { aspect-ratio: auto; min-height: 320px; }
    .une-corps { padding: 2rem 2.2rem; }
  }

  .une-kicker {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--kaki-texte);
    opacity: 1;
    margin-bottom: 0.6rem;
  }

  .une-titre {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    line-height: 1.2;
    margin-bottom: 0.9rem;
  }

  .une-desc { color: #F5E6C8; margin-bottom: 1.2rem; }

  .une-meta,
  .fiche-article-meta {
    font-size: 0.85rem;
    color: var(--gris-texte);
    opacity: 1;
    margin: 0;
    letter-spacing: 0.5px;
  }
  .une-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; align-items: baseline; }
  .une-lire { color: #F5A623; font-weight: 700; letter-spacing: 1px; }

  /* ---------- DERNIÈRES FICHES ---------- */
  .dernieres-grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 1.25rem;
  }
  @media (min-width: 600px) { .dernieres-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .dernieres-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .dernieres-grid li { display: flex; }

  .fiche-article {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    background-color: #0d0d0d;
    transition: background-color 0.2s;
  }
  .fiche-article:hover { background-color: #141414; }
  .fiche-article:hover h3 { text-decoration: underline; text-underline-offset: 3px; }

  .fiche-article :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; }

  .fiche-article-corps { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }

  .fiche-article h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.5px;
    color: #ffffff;
    flex: 1;
  }

  /* ---------- C'EST QUOI CE SITE ---------- */
  .reassurance { max-width: 800px; margin: 0 auto; }

  .reassurance-texte { font-size: 1.1rem; line-height: 1.9; margin-bottom: 1.5rem; color: #ffffff; }
  .reassurance-texte em { color: #F5A623; font-style: normal; font-weight: 700; }

  .reassurance-points {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem 2rem;
  }
  @media (min-width: 700px) { .reassurance-points { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .reassurance-points li {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.6;
    color: #F5E6C8;
    padding-left: 1.1rem;
    position: relative;
  }
  .reassurance-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 2px;
    background-color: #F5A623;
  }

  /* ---------- PAR OÙ COMMENCER ---------- */
  .demarrer h2 { margin-bottom: 0.5rem; }
