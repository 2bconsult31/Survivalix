---
import GuideOutil from '../../components/GuideOutil.astro';
import PlancheOutil from '../../components/PlancheOutil.astro';
import Layout from '../../layouts/Layout.astro';

const outils = [
  {
    slug: "/outils/calculateur-stock-eau",
    planche: "eau" as const,
    titre: "Calculateur de stock d'eau",
    description: "Combien de litres stocker selon le nombre de personnes et la durée visée. Le calcul qu'on aurait dû faire avant.",
    tags: ["eau", "stock", "calcul", "kit-72h"],
    temps: "2 min"
  },
  {
    slug: "/outils/calculateur-rations-alimentaires",
    planche: "rations" as const,
    titre: "Calculateur de rations alimentaires",
    description: "Combien de calories stocker selon ta famille et la durée visée ? Liste de courses incluse, calculée avec la table Ciqual de l'ANSES.",
    tags: ["calories", "rations", "stock", "alimentation"],
    temps: "2 min"
  },
  {
    slug: "/outils/evaluateur-preparation",
    planche: "evaluateur" as const,
    titre: "Évaluateur de préparation",
    description: "10 questions pour savoir où tu en es vraiment. Score sur 100, recommandations personnalisées. Honnête, sans détour.",
    tags: ["score", "évaluation", "bilan", "préparation"],
    temps: "3 min"
  },
  {
    slug: "/outils/generateur-kit-72h",
    planche: "kit" as const,
    titre: "Générateur de kit 72h personnalisé",
    description: "Adultes, enfants, bébés, animaux : ton kit ajusté à ton vrai foyer, module bébé inclus. Plus rapide que de tout recalculer à la main.",
    tags: ["kit-72h", "famille", "bébé", "personnalisé"],
    temps: "2 min"
  }
]
---

<Layout title="Calculateurs Survie : Eau, Rations, Autonomie | Survivalix" description="Combien d'eau, combien de nourriture, êtes-vous vraiment prêt ? Nos calculateurs gratuits vous donnent la réponse en 2 minutes, chiffres à l'appui.">

  <div class="manuel-header">
    <div class="manuel-header-label">// SECTION 04 //</div>
    <h1>Les Outils</h1>
    <p class="manuel-header-desc">Calculateurs et outils interactifs pour préparer ton autonomie. Concrets, rapides, sans blabla.</p>
    <div class="manuel-stats">
      <span><strong>{outils.length}</strong> outil{outils.length > 1 ? 's' : ''} disponible{outils.length > 1 ? 's' : ''}</span>
    </div>
  </div>

  <div class="manuel-grid">
    {outils.map((outil, index) => (
      <a href={outil.slug} class="article-card article-card-link fiche" data-onglet={`0${index + 1}`}>
        <div class="card-image">
          <PlancheOutil outil={outil.planche} />
        </div>
        <div class="card-body">
          <div class="card-top">
            <span class="card-temps">~{outil.temps}</span>
          </div>
          <div class="card-tags">
            {outil.tags.map((tag: string) => (
              <span class="card-tag">#{tag}</span>
            ))}
          </div>
          <h2 class="card-titre">{outil.titre}</h2>
          <p class="card-desc">{outil.description}</p>
          <div class="card-footer">
            <span class="card-lien">
              Utiliser l'outil
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line x1="4" y1="12" x2="20" y2="12" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round"/>
                <polyline points="14,6 20,12 14,18" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <GuideOutil id="guide-outils">
    <h2 id="guide-outils-titre">Par quel outil commencer ?</h2>
    <p>Quatre outils, quatre questions que tout le monde finit par se poser : combien d'eau garder chez soi, combien de nourriture, où on en est vraiment, et quoi rassembler concrètement. Ils se complètent, et l'ordre compte.</p>
    <ul>
      <li><strong>L'évaluateur de préparation</strong> d'abord : dix questions, trois minutes, et tu vois tout de suite ce qui manque.</li>
      <li><strong>Les calculateurs d'eau et de rations</strong> ensuite, pour chiffrer ces manques selon la taille de ton foyer et la durée visée.</li>
      <li><strong>Le générateur de kit 72 h</strong> pour finir : il transforme tout ça en liste à cocher, au fur et à mesure de tes achats.</li>
    </ul>

    <h3>D'où viennent les chiffres</h3>
    <p>Chaque outil part d'un repère publié par un organisme officiel. Pour l'eau, c'est le kit d'urgence du Gouvernement : 6 litres par personne pour 72 heures. Pour les calories, ce sont les repères de l'ANSES pour les adultes et la table de composition Ciqual pour les aliments. Les listes s'appuient sur le guide « Tous responsables » publié par le SGDSN en novembre 2025, sur les recommandations de la Sécurité civile et sur celles de la Croix-Rouge française. Quand un outil s'écarte d'un repère officiel (une durée plus longue que 72 heures, un niveau d'activité), la page le dit.</p>

    <h3>Ce qu'ils ne font pas</h3>
    <p>Ces outils donnent des ordres de grandeur pour s'organiser à l'avance. Ils ne remplacent ni un avis médical (traitement, grossesse, allergie, nourrisson), ni les consignes de ta préfecture le jour où une alerte tombe. Ils ne savent rien non plus des risques propres à ta commune : pour ça, regarde notre fiche sur les <a href="/manuel/risques-pres-de-chez-soi">risques près de chez toi</a>.</p>
    <p>Côté données, les calculs se font dans ton navigateur et rien n'est envoyé. Seul le générateur de kit garde tes cases cochées, sur ton appareil uniquement.</p>

    <h3>Pour aller plus loin</h3>
    <ul>
      <li><a href="/manuel/kit-urgence-72h">Le guide complet du kit d'urgence 72 h</a></li>
      <li><a href="/manuel/stocker-eau-appartement">Stocker de l'eau en appartement</a></li>
      <li><a href="/manuel/liste-courses-prepper-debutant">La liste de courses pour débuter</a></li>
      <li><a href="/survivant">Le quiz « Quel survivant es-tu ? »</a>, pour la partie ludique, et <a href="/bunker">le Bunker</a> pour une question précise.</li>
    </ul>
  </GuideOutil>
</Layout>

<style>
  .manuel-header {
    text-align: center;
    padding: 3rem 0 2rem;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 3rem;
  }
  .manuel-header-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    color: var(--kaki-texte);
    letter-spacing: 4px;
    margin-bottom: 1rem;
  }
  .manuel-header h1 {
    font-family: 'Special Elite', cursive;
    font-size: clamp(2rem, 6vw, 3.5rem);
    color: #F5A623;
    letter-spacing: 4px;
    margin-bottom: 1rem;
  }
  .manuel-header-desc {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    color: #F5E6C8;
    opacity: 0.7;
    font-weight: 300;
    margin-bottom: 1.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .manuel-stats {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    color: var(--gris-texte);
    letter-spacing: 2px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }
  .manuel-stats strong { color: #F5A623; }
  .manuel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .manuel-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .manuel-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .article-card {
    background-color: #0d0d0d;
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s;
    text-decoration: none;
  }
  .article-card-link:hover { background-color: #141414; }
  .article-card-link:hover .card-titre { text-decoration: underline; text-underline-offset: 3px; }
  .card-image :global(svg) { width: 100%; height: 100%; display: block; }
  .card-image {
    width: 100%;
    height: 160px;
    overflow: hidden;
    position: relative;
    background-color: #0d0d0d;
  }
  .card-body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .card-top {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .card-temps {
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    color: var(--gris-texte);
    letter-spacing: 1px;
    border: 1px solid #222;
    padding: 0.2rem 0.6rem;
  }
  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .card-tag {
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    color: var(--kaki-texte);
    letter-spacing: 1px;
    border: 1px solid #6B7C45;
    padding: 0.1rem 0.5rem;
  }
  .card-titre {
    font-family: 'Special Elite', cursive;
    font-size: clamp(0.9rem, 2vw, 1rem);
    color: #F5E6C8;
    line-height: 1.3;
    letter-spacing: 0.5px;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .card-desc {
    font-family: 'Oswald', sans-serif;
    font-size: 0.82rem;
    color: #F5E6C8;
    opacity: 0.55;
    line-height: 1.6;
    font-weight: 300;
    flex: 1;
    margin: 0 !important;
  }
  .card-footer {
    margin-top: 0.5rem;
    padding-top: 0.8rem;
    border-top: 1px solid #1a1a1a;
  }
  .card-lien {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #F5A623;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.2s;
  }
  .card-lien svg { width: 14px; height: 14px; flex-shrink: 0; }
  .article-card-link:hover .card-lien { gap: 0.8rem; }
</style>
