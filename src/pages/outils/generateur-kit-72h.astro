---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Ta checklist kit 72h personnalisée — Survivalix"
  description="Génère la vraie liste d'objets à rassembler selon ton foyer, coche au fur et à mesure. Ta progression est sauvegardée, tu peux y revenir quand tu veux."
>

  <div class="page-header">
    <div class="page-label">// OUTIL INTERACTIF //</div>
    <h1>Ta checklist kit 72h, personnalisée</h1>
    <p class="page-desc">
      Pas un chiffre à regarder une fois. Une vraie liste à cocher,
      ajustée à ton foyer, qui garde ta progression.
    </p>
  </div>

  <div class="foyer-card">
    <div class="foyer-grid">

      <div class="foyer-item">
        <label>Adultes</label>
        <div class="counter">
          <button type="button" onclick="decrement('adultes')">−</button>
          <span id="adultes-val">2</span>
          <button type="button" onclick="increment('adultes')">+</button>
        </div>
      </div>

      <div class="foyer-item">
        <label>Enfants (2-12 ans)</label>
        <div class="counter">
          <button type="button" onclick="decrement('enfants')">−</button>
          <span id="enfants-val">0</span>
          <button type="button" onclick="increment('enfants')">+</button>
        </div>
      </div>

      <div class="foyer-item">
        <label>Bébés (moins de 2 ans)</label>
        <div class="counter">
          <button type="button" onclick="decrement('bebes')">−</button>
          <span id="bebes-val">0</span>
          <button type="button" onclick="increment('bebes')">+</button>
        </div>
      </div>

      <div class="foyer-item">
        <label>Animaux</label>
        <div class="counter">
          <button type="button" onclick="decrement('animaux')">−</button>
          <span id="animaux-val">0</span>
          <button type="button" onclick="increment('animaux')">+</button>
        </div>
      </div>

    </div>

    <div class="foyer-item foyer-select" id="bebe-select-wrap" style="display: none;">
      <label for="tranche-bebe">Âge du bébé (le plus jeune si plusieurs)</label>
      <div class="select-wrapper">
        <select id="tranche-bebe" onchange="rebuildChecklist()">
          <option value="allaite">0-6 mois — allaité</option>
          <option value="biberon" selected>0-6 mois — au biberon</option>
          <option value="diversifie">6-12 mois — diversifié</option>
          <option value="grand">12-24 mois</option>
        </select>
      </div>
    </div>
  </div>

  <div class="progress-bar-card">
    <div class="progress-top">
      <span class="progress-label" id="progress-label">0 / 0 rassemblés</span>
      <button type="button" class="btn-reset" onclick="resetChecklist()">Réinitialiser</button>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progress-fill" style="width: 0%;"></div>
    </div>
  </div>

  <div class="checklist-container" id="checklist-container"></div>

  <div class="result-actions">
    <a href="/manuel/kit-urgence-72h" class="btn-lien">Voir le guide kit 72h complet →</a>
    <a href="/manuel/kit-urgence-bebe-nourrisson" class="btn-lien" id="lien-bebe" style="display: none;">Voir le guide kit bébé →</a>
    <a href="/bunker" class="btn-lien">Poser une question au Bunker →</a>
  </div>

  <p class="result-sources">
    Quantités basées sur les recommandations Croix-Rouge française, ANSES et FEMA, et sur les repères
    de notre guide kit d'urgence bébé et nourrisson. Ta progression est sauvegardée uniquement sur cet
    appareil (localStorage) — elle n'est jamais envoyée ni partagée.
  </p>

</Layout>

<script is:inline>
  const vals = { adultes: 2, enfants: 0, bebes: 0, animaux: 0 };
  const STORAGE_KEY = 'survivalix-kit72h-checklist';

  function increment(key) {
    const max = key === 'animaux' ? 5 : (key === 'bebes' ? 4 : 10);
    if (vals[key] < max) { vals[key]++; }
    document.getElementById(`${key}-val`).textContent = vals[key];
    rebuildChecklist();
  }

  function decrement(key) {
    const min = key === 'adultes' ? 1 : 0;
    if (vals[key] > min) { vals[key]--; }
    document.getElementById(`${key}-val`).textContent = vals[key];
    rebuildChecklist();
  }

  function loadChecked() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch (e) {
      return {};
    }
  }

  function saveChecked(map) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
    } catch (e) { /* stockage indisponible, on continue sans persister */ }
  }

  function resetChecklist() {
    saveChecked({});
    rebuildChecklist();
  }

  function toggleItem(id) {
    const checked = loadChecked();
    checked[id] = !checked[id];
    saveChecked(checked);
    updateProgress();
  }

  function buildItems() {
    const tranche = document.getElementById('tranche-bebe').value;
    const personnes = vals.adultes + vals.enfants;

    const litresEau = Math.ceil(vals.adultes * 2 * 3 + vals.enfants * 1.5 * 3);
    const litresHygiene = Math.ceil((vals.adultes + vals.enfants * 0.7) * 0.5 * 3);
    const litresBiberon = vals.bebes > 0 && (tranche === 'biberon' || tranche === 'diversifie')
      ? Math.ceil(vals.bebes * 1 * 3) : 0;
    const totalLitres = litresEau + litresHygiene + litresBiberon;
    const bouteilles = Math.ceil(totalLitres / 1.5);

    const couchesParJour = { allaite: 9, biberon: 9, diversifie: 7, grand: 6 }[tranche];
    const totalCouches = vals.bebes > 0 ? couchesParJour * vals.bebes * 3 : 0;

    const categories = [
      {
        nom: 'EAU',
        items: [
          { id: 'eau-bouteilles', label: `${bouteilles} bouteilles d'eau 1,5L (${totalLitres} L au total pour 72h)` },
          { id: 'eau-pastilles', label: 'Pastilles de purification (type Micropur), au cas où' }
        ]
      },
      {
        nom: 'NOURRITURE',
        items: [
          { id: 'nourriture-conserves', label: `${Math.max(2, Math.ceil(personnes * 1.5))} conserves (légumineuses, thon, sardines)` },
          { id: 'nourriture-barres', label: `${Math.max(3, personnes * 2)} barres énergétiques ou biscuits secs` },
          { id: 'nourriture-ouvreboite', label: '1 ouvre-boîte manuel — vraiment, ne l\'oublie pas' },
          ...(vals.enfants > 0 ? [{ id: 'nourriture-enfants', label: 'Compotes en gourde et céréales sèches pour les enfants' }] : [])
        ]
      },
      {
        nom: 'LUMIÈRE & ÉNERGIE',
        items: [
          { id: 'energie-lampes', label: `${Math.max(1, Math.ceil(vals.adultes / 2))} lampe(s) frontale(s) + piles de rechange` },
          { id: 'energie-batterie', label: `${Math.max(1, Math.ceil(personnes / 2))} batterie(s) externe(s) 20 000 mAh` },
          { id: 'energie-radio', label: '1 radio à piles ou à manivelle' },
          { id: 'energie-bougies', label: 'Bougies + briquet ou allumettes imperméables' }
        ]
      },
      {
        nom: 'SANTÉ & PREMIERS SECOURS',
        items: [
          { id: 'sante-trousse', label: '1 trousse de premiers secours complète' },
          { id: 'sante-medicaments', label: 'Médicaments personnels sur ordonnance — 3 jours minimum' },
          { id: 'sante-thermometre', label: '1 thermomètre' },
          { id: 'sante-masques', label: `${Math.max(2, personnes)} masques FFP2` }
        ]
      },
      {
        nom: 'CHALEUR & VÊTEMENTS',
        items: [
          { id: 'chaleur-couvertures', label: `${Math.max(1, personnes)} couverture(s) de survie (jamais directement sur un bébé)` },
          { id: 'chaleur-vetements', label: `${Math.max(1, personnes)} tenue(s) de rechange pour 3 jours` },
          { id: 'chaleur-chaussures', label: 'Chaussures de marche solides par adulte' }
        ]
      },
      {
        nom: 'DOCUMENTS',
        items: [
          { id: 'documents-photocopies', label: 'Photocopies dans une pochette étanche (identité, carte vitale)' },
          { id: 'documents-numeros', label: 'Numéros de téléphone importants écrits sur papier' },
          { id: 'documents-especes', label: 'Espèces en petites coupures' }
        ]
      },
      {
        nom: 'DIVERS',
        items: [
          { id: 'divers-couteau', label: '1 couteau multifonction' },
          { id: 'divers-sifflet', label: '1 sifflet' },
          { id: 'divers-tape', label: '1 rouleau de ruban adhésif résistant (duct tape)' },
          { id: 'divers-sacs', label: 'Sacs poubelle résistants' },
          { id: 'divers-hygiene', label: 'Papier hygiénique, lingettes, gel hydroalcoolique' }
        ]
      }
    ];

    if (vals.bebes > 0) {
      const laitItem = tranche === 'allaite'
        ? { id: 'bebe-lait', label: '1 boîte de lait 1er âge de secours (en cas de baisse de lactation)' }
        : { id: 'bebe-lait', label: `${vals.bebes} boîte(s) de lait 1er âge en poudre (900g)` };

      categories.push({
        nom: 'MODULE BÉBÉ',
        items: [
          { id: 'bebe-couches', label: `${totalCouches} couches pour 72h` },
          laitItem,
          { id: 'bebe-biberons', label: `${Math.max(2, vals.bebes * 2)} biberons` },
          { id: 'bebe-echarpe', label: 'Écharpe ou porte-bébé physiologique (jamais de couverture de survie sur un bébé)' },
          { id: 'bebe-thermometre', label: '1 thermomètre frontal bébé' }
        ]
      });
    }

    return categories;
  }

  function rebuildChecklist() {
    document.getElementById('bebe-select-wrap').style.display = vals.bebes > 0 ? 'flex' : 'none';
    document.getElementById('lien-bebe').style.display = vals.bebes > 0 ? 'block' : 'none';

    const categories = buildItems();
    const checked = loadChecked();
    const container = document.getElementById('checklist-container');
    container.innerHTML = '';

    categories.forEach((cat) => {
      const catEl = document.createElement('div');
      catEl.className = 'checklist-category';

      const labelEl = document.createElement('div');
      labelEl.className = 'checklist-category-label';
      labelEl.textContent = `// ${cat.nom} //`;
      catEl.appendChild(labelEl);

      cat.items.forEach((item) => {
        const row = document.createElement('label');
        row.className = 'checklist-item';

        const input = document.createElement('input');
        input.type = 'checkbox';
        input.checked = !!checked[item.id];

        const span = document.createElement('span');
        span.textContent = item.label;
        if (input.checked) span.classList.add('checked-text');

        input.addEventListener('change', () => {
          toggleItem(item.id);
          span.classList.toggle('checked-text', input.checked);
        });

        row.appendChild(input);
        row.appendChild(span);
        catEl.appendChild(row);
      });

      container.appendChild(catEl);
    });

    updateProgress();
  }

  function updateProgress() {
    const checkboxes = document.querySelectorAll('.checklist-item input[type="checkbox"]');
    const total = checkboxes.length;
    const done = Array.from(checkboxes).filter((cb) => cb.checked).length;
    const pct = total > 0 ? Math.round((done / total) * 100) : 0;

    document.getElementById('progress-label').textContent = `${done} / ${total} rassemblés`;
    document.getElementById('progress-fill').style.width = `${pct}%`;
  }

  rebuildChecklist();
</script>

<style>
  .page-header {
    text-align: center;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 2.5rem;
  }

  .page-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    color: #6B7C45;
    letter-spacing: 4px;
    margin-bottom: 1rem;
  }

  .page-header h1 {
    font-family: 'Special Elite', cursive;
    font-size: clamp(1.8rem, 5vw, 3rem);
    color: #F5A623;
    letter-spacing: 3px;
    margin-bottom: 1rem;
  }

  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0.8;
  }

  .foyer-card {
    max-width: 900px;
    margin: 0 auto 1.5rem;
    background-color: #111;
    border: 1px solid #1e1e1e;
    border-top: 3px solid #F5A623;
    padding: 1.5rem;
  }

  .foyer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem 2rem;
  }

  @media (min-width: 700px) {
    .foyer-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .foyer-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .foyer-item label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    color: #ffffff;
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  .foyer-select {
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid #1e1e1e;
    max-width: 360px;
  }

  .counter {
    display: flex;
    align-items: center;
    border: 1px solid #333;
    width: fit-content;
  }

  .counter button {
    background: none;
    border: none;
    color: #F5A623;
    font-size: 1.2rem;
    font-weight: 700;
    width: 36px;
    height: 36px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
    font-family: 'Oswald', sans-serif;
  }

  .counter button:hover { background-color: #1a1a1a; }

  .counter span {
    font-family: 'Special Elite', cursive;
    font-size: 1.2rem;
    color: #ffffff;
    width: 36px;
    text-align: center;
    border-left: 1px solid #333;
    border-right: 1px solid #333;
    line-height: 36px;
  }

  .select-wrapper select {
    width: 100%;
    background-color: #0d0d0d;
    border: 1px solid #333;
    color: #ffffff;
    font-family: 'Oswald', sans-serif;
    font-size: 0.85rem;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
    appearance: none;
    font-weight: 300;
  }

  .select-wrapper select:focus {
    outline: none;
    border-color: #F5A623;
  }

  .progress-bar-card {
    max-width: 900px;
    margin: 0 auto 2rem;
    background-color: #111;
    border: 1px solid #1e1e1e;
    padding: 1rem 1.5rem;
    position: sticky;
    top: 1rem;
    z-index: 10;
  }

  .progress-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .progress-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.85rem;
    color: #F5A623;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .btn-reset {
    font-family: 'Oswald', sans-serif;
    font-size: 0.72rem;
    color: #ffffff;
    opacity: 0.5;
    background: none;
    border: 1px solid #333;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: opacity 0.2s;
  }

  .btn-reset:hover { opacity: 1; border-color: #F5A623; }

  .progress-track {
    width: 100%;
    height: 8px;
    background-color: #0d0d0d;
    border: 1px solid #1e1e1e;
  }

  .progress-fill {
    height: 100%;
    background-color: #F5A623;
    transition: width 0.3s ease;
  }

  .checklist-container {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  @media (min-width: 700px) {
    .checklist-container { grid-template-columns: repeat(2, 1fr); }
  }

  .checklist-category {
    background-color: #0d0d0d;
    border: 1px solid #1e1e1e;
    border-left: 3px solid #F5A623;
    padding: 1.2rem;
  }

  .checklist-category-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.7rem;
    color: #6B7C45;
    letter-spacing: 3px;
    margin-bottom: 0.9rem;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.4rem 0;
    cursor: pointer;
  }

  .checklist-item input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #F5A623;
    flex-shrink: 0;
    margin-top: 1px;
    cursor: pointer;
  }

  .checklist-item span {
    font-family: 'Oswald', sans-serif;
    font-size: 0.85rem;
    color: #F5E6C8;
    font-weight: 300;
    line-height: 1.5;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .checked-text {
    opacity: 0.4 !important;
    text-decoration: line-through;
  }

  .result-actions {
    max-width: 900px;
    margin: 2.5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn-lien {
    font-family: 'Oswald', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    color: #F5A623;
    text-decoration: none;
    letter-spacing: 1px;
    padding: 0.6rem 1rem;
    border: 1px solid #333;
    text-align: center;
    transition: all 0.2s;
  }

  .btn-lien:hover {
    border-color: #F5A623;
    background-color: #111;
  }

  .result-sources {
    max-width: 900px;
    margin: 1.5rem auto 3rem;
    font-family: 'Oswald', sans-serif;
    font-size: 0.72rem;
    color: #ffffff;
    opacity: 0.35;
    font-weight: 300;
    line-height: 1.6;
    border-top: 1px solid #1a1a1a;
    padding-top: 1rem;
  }
</style>
